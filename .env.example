# Signal Atlas Environment Configuration

# Database Configuration (Docker Compose PostgreSQL defaults to port 5433 to avoid host port collisions)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=signal_atlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/signal_atlas

# Ingestion & Archive Directories
SIGNAL_ATLAS_DATA_DIR=data
SIGNAL_ATLAS_RAW_DIR=data/raw
