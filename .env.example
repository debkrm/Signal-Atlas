# Signal Atlas Environment Configuration Template
# Copy this file to .env and configure local credentials before starting services.
# NEVER commit your real .env file or credentials to version control.

# Database Credentials (Mandatory: set a secure local password)
POSTGRES_USER=signal_atlas_user
POSTGRES_PASSWORD=replace_with_a_secure_local_password
POSTGRES_DB=signal_atlas
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Database Connection URL (Constructed from credentials above)
DATABASE_URL=postgresql+psycopg2://signal_atlas_user:replace_with_a_secure_local_password@127.0.0.1:5433/signal_atlas

# Dedicated Test Database Connection URL (Isolated from development/application database)
TEST_DATABASE_URL=postgresql+psycopg2://signal_atlas_user:replace_with_a_secure_local_password@127.0.0.1:5433/signal_atlas_test

# Ingestion & Archive Directories
SIGNAL_ATLAS_DATA_DIR=data
SIGNAL_ATLAS_RAW_DIR=data/raw
